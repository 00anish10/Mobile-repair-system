# Copy to .env before running: docker compose up --build
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
DB_PASSWORD=password
APP_ORIGIN=http://localhost:8080

# Optional transactional email (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="Moon Mobile Repair <bookings@yourdomain.com>"

# Optional SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
