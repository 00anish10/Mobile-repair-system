# Database Configuration
# Option A: full connection string (wins over DB_* values when set)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/moon_mobile_repair

# Option B: discrete settings
DB_NAME=moon_mobile_repair
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional: set to true for hosted PostgreSQL requiring SSL
# DB_SSL=false
PG_POOL_MAX=10

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins, or * in development)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# App
APP_URL=http://localhost:3000

# Run schema.sql + seed.sql on boot (set to false to manage manually)
RUN_MIGRATIONS=true
